  {
    "id": "TC001",
    "title": "Signup fails when email is already registered",
    "description": "Verifies an error message is shown when attempting to sign up with an email that already exists.",
    "category": "User Authentication - Signup",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /signup"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/signup\""
      },
      {
        "type": "action",
        "description": "Type \"existing.user@example.com\" into the email input field"
      },
      {
        "type": "action",
        "description": "Type \"ValidPassw0rd!234\" into the password input field"
      },
      {
        "type": "action",
        "description": "Click Submit button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"already\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"email\" is visible"
      }
    ]
  },
